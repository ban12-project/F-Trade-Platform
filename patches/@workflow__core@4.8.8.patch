--- /dev/null
+++ b/dist/workflow/replay-nanoid.js
@@ -0,0 +1,17 @@
+import { customRandom, urlAlphabet } from 'nanoid';
+
+// Existing Workflow runs share this seeded RNG with Math.random() and ULIDs.
+// nanoid 5.1.6 consumed 34 bytes, then read its final 21 in reverse order.
+// nanoid 5.1.16 requests only 21 bytes for this 64-character alphabet. Preserve
+// both the token and all 34 RNG draws while using the patched library unchanged.
+// This adapter is only for Workflow's fixed 21-character replay token contract.
+export function createReplayNanoid(random) {
+    const generate = customRandom(urlAlphabet, 21, (size) => {
+        if (size !== 21) {
+            throw new RangeError('Workflow replay nanoid requires 21 bytes');
+        }
+        const bytes = new Uint8Array(34).map(() => 256 * random());
+        return bytes.subarray(13);
+    });
+    return () => generate();
+}
