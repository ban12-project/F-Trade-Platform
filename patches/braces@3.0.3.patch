diff --git alib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..d366d0e78c024ac52cbeff164d09f3449bbe7ee6
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// Local defense for GHSA-vfj7-8cjw-p6xm; shared by parsing and AST entry points.
+const MAX_DEPTH = 128;
+
+const depthError = () => {
+  const error = new RangeError(`Brace pattern nesting exceeds maximum depth (${MAX_DEPTH})`);
+  error.code = 'BRACES_DEPTH_LIMIT';
+  return error;
+};
+
+// Validate iteratively so a caller-provided AST cannot exhaust the JS stack.
+// Only container nodes count; parent/prev references are not traversal edges.
+const assertDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+    if (!node || !node.nodes) continue;
+    if (depth > MAX_DEPTH) throw depthError();
+    for (const child of node.nodes) {
+      stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, depthError, assertDepth };
