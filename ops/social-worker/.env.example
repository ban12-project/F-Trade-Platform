# No values in this file are usable credentials. Keep the real .env only on the approved VPS.
SOCIAL_WORKER_IMAGE=registry.example/f-trade-social-worker:reviewed-tag
SOCIAL_WORKER_ID=worker-us-east-001
SOCIAL_WORKER_SIGNING_KEY=replace-with-base64-encoded-32-byte-minimum-key
SOCIAL_WORKER_API_KEY=replace-with-a-separate-random-api-key
SOCIAL_MESSAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SOCIAL_WORKER_STATE_DIR=/var/lib/social-worker
SOCIAL_WORKER_TELEMETRY_ENABLED=false
SOCIAL_WORKER_TRACE_ENABLED=false
