{
  "compilerOptions": {
    "target": "ES2017",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "scripts/test-product-review-write-access-postgres.mts",
    "scripts/test-product-review-action-errors.mts",
    "scripts/test-content-review-write-access-postgres.mts",
    "scripts/test-content-review-action-errors.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
