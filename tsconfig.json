{
  "compilerOptions": {
    "target": "ES2017",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "scripts/build-browser-sandbox-template.mts",
    "scripts/test-browser-sandbox-template.mts",
    "scripts/test-product-review-write-access-postgres.mts",
    "scripts/test-product-review-action-errors.mts",
    "scripts/test-content-review-write-access-postgres.mts",
    "scripts/test-content-review-action-errors.mts",
    "scripts/test-content-draft-write-access-postgres.mts",
    "scripts/test-content-draft-action-errors.mts",
    "scripts/test-content-edit-write-access-postgres.mts",
    "scripts/test-content-edit-action-errors.mts",
    "scripts/test-video-review-evidence-postgres.mts",
    "scripts/test-video-retention-postgres.mts",
    "scripts/test-browser-publication-inspection-action.mts",
    "scripts/test-publication-submission-wakeup-postgres.mts",
    "scripts/test-facebook-video-caption-postgres.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    ".next-playwright-ui",
    ".next-playwright-database",
    "node_modules",
    "tmp",
    "ops/browser-node/upstream",
    ".tsconfig-playwright-*.json"
  ]
}
