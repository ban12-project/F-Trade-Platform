DATABASE_URL=postgresql://user:password@example.neon.tech/f_trade?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_PASSKEY_RP_ID=localhost
RESEND_API_KEY=re_replace_with_resend_api_key
AUTH_EMAIL_FROM=F-Trade <no-reply@example.com>
BLOB_READ_WRITE_TOKEN=vercel_blob_private_store_token
# Required to encrypt credentials saved through the Agent configuration UI. Generate with:
# openssl rand -base64 32
MODEL_CONFIG_ENCRYPTION_KEY=
# Optional remote OCR provider. These credentials are not read by Product Agent runtime.
F_TRADE_OCR_OPENAI_COMPATIBLE_BASE_URL=
F_TRADE_OCR_OPENAI_COMPATIBLE_API_KEY=
F_TRADE_OCR_MODEL=
MARKITDOWN_OCR_ENABLED=0
# MVP1 deterministic marketing-video editing. The FFmpeg build must include libass.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Text/image-to-video generation is outside MVP1 and fails closed by default.
VIDEO_GENERATION_ENABLED=0
