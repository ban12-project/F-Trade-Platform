DATABASE_URL=postgresql://user:password@example.neon.tech/f_trade?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_PASSKEY_RP_ID=localhost
RESEND_API_KEY=re_replace_with_resend_api_key
AUTH_EMAIL_FROM=F-Trade <no-reply@example.com>
BLOB_READ_WRITE_TOKEN=vercel_blob_private_store_token
# Used by @vercel/blob private reads when an OIDC deployment has no long-lived token.
BLOB_STORE_ID=
# Required by the presigned-upload completion webhook in production.
BLOB_WEBHOOK_PUBLIC_KEY=
# Local-only callback override, for example an HTTPS tunnel to /api/video-assets/upload.
VERCEL_BLOB_CALLBACK_URL=
# Required to encrypt credentials saved through the Agent configuration UI. Generate with:
# openssl rand -base64 32
MODEL_CONFIG_ENCRYPTION_KEY=
# Optional remote OCR provider. These credentials are not read by Product Agent runtime.
F_TRADE_OCR_OPENAI_COMPATIBLE_BASE_URL=
F_TRADE_OCR_OPENAI_COMPATIBLE_API_KEY=
F_TRADE_OCR_MODEL=
MARKITDOWN_OCR_ENABLED=0
# Dedicated VPS computation. Missing credentials fail closed; no automatic Vercel fallback.
COMPUTE_PROVIDER=vercel
# Digest-pinned VCR compute image (document, FFmpeg, Remotion); no runtime installs.
COMPUTE_SANDBOX_IMAGE=
# Exact trusted origin for self-managed browser inspection and viewer tickets.
BROWSER_VPS_GATEWAY_ORIGIN=https://browser.example.com
# Legacy Sandbox creation is permanently retired; this flag cannot re-enable it.
BROWSER_SANDBOX_ENABLED=0
# Opt-in rollout for the experimental Remotion ABCD compositor. Non-vertical presets keep the FFmpeg fallback.
VIDEO_COMPOSITOR=ffmpeg
# Text/image-to-video generation is outside MVP1 and fails closed by default.
VIDEO_GENERATION_ENABLED=0
# Controlled social Worker. Use independent random values in the application and approved VPS secret stores.
SOCIAL_WORKER_ID=worker-us-east-001
SOCIAL_WORKER_API_KEY=
# Base64-encoded key of at least 32 bytes for signed commands/results.
SOCIAL_WORKER_SIGNING_KEY=
# Base64-encoded 32-byte key for the isolated 30-day message store.
SOCIAL_MESSAGE_ENCRYPTION_KEY=

# Authenticates the hourly video retention scheduler.
CRON_SECRET=
