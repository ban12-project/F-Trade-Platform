{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/channel-onboarding.schema.json",
  "title": "ChannelOnboardingManifest",
  "description": "Credential-free evidence of official social-channel onboarding. This contract intentionally rejects browser-session and secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "channel_ref", "account_ref", "platform", "account_type", "ownership_status", "official_oauth_status", "publishing_path", "inbound_path", "inbound_only", "reply_window_status", "browser_automation_production", "external_effects_require_human_approval", "credentials_managed_externally", "production_readiness", "evidence_refs"],
  "properties": {
    "classification": {"enum": ["synthetic", "sanitized_aggregate"]},
    "channel_ref": {"type": "string", "pattern": "^(synthetic|sanitized|evidence)-[a-z0-9-]+$"},
    "account_ref": {"type": "string", "pattern": "^(synthetic|sanitized|evidence)-[a-z0-9-]+$"},
    "platform": {"enum": ["instagram", "facebook", "whatsapp", "tiktok", "linkedin", "other"]},
    "account_type": {"enum": ["business", "professional", "page", "waba", "other"]},
    "ownership_status": {"enum": ["unverified", "verified"]},
    "official_oauth_status": {"enum": ["not_started", "connected", "tested"]},
    "publishing_path": {"enum": ["postiz_official_api", "human_only"]},
    "inbound_path": {"enum": ["chatwoot_official_webhook", "human_only"]},
    "inbound_only": {"const": true},
    "reply_window_status": {"enum": ["unconfirmed", "confirmed"]},
    "reply_window_minutes": {"type": "integer", "minimum": 1, "maximum": 43200},
    "browser_automation_production": {"const": false},
    "external_effects_require_human_approval": {"const": true},
    "credentials_managed_externally": {"const": true},
    "production_readiness": {"enum": ["not_ready", "test_ready", "approved"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(synthetic|sanitized|evidence)-[a-z0-9-]+$"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reply_window_status": {"const": "confirmed"}}, "required": ["reply_window_status"]},
      "then": {"required": ["reply_window_minutes"]},
      "else": {"not": {"required": ["reply_window_minutes"]}}
    }
  ]
}
