{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/channel-inbound-policy.schema.json",
  "title": "ChannelInboundPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_ref", "account_ref", "official_api", "inbound_only", "reply_window_minutes", "outside_window_action"],
  "properties": {
    "channel_ref": {"type": "string", "pattern": "^(synthetic|sanitized)-[a-z0-9-]+$"},
    "account_ref": {"type": "string", "pattern": "^(synthetic|sanitized)-[a-z0-9-]+$"},
    "official_api": {"const": true},
    "inbound_only": {"const": true},
    "reply_window_minutes": {"type": "integer", "minimum": 1, "maximum": 43200},
    "outside_window_action": {"enum": ["block", "require_approved_template"]}
  }
}
