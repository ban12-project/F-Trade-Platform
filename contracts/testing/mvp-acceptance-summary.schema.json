{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/mvp-acceptance-summary.schema.json",
  "title": "MvpAcceptanceSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "run_id", "executed_at", "criteria", "metrics", "decision"],
  "properties": {
    "classification": {"enum": ["synthetic", "sanitized_aggregate"]},
    "run_id": {"type": "string", "pattern": "^(synthetic|sanitized)-[a-z0-9-]+$"},
    "executed_at": {"type": "string", "format": "date-time"},
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence_refs"],
        "properties": {
          "criterion_id": {
            "enum": ["product_import", "content_gate", "rfq_completion", "quotation_handoff", "follow_up_opportunity", "gate_bypass"]
          },
          "status": {"enum": ["passed", "failed", "not_run"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^(synthetic|sanitized|evidence)-[a-z0-9-]+$"}
          },
          "failure_code": {
            "enum": ["source_unavailable", "fact_mismatch", "rfq_incomplete", "gate_rejected", "gate_bypass", "technical_failure", "external_dependency"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
            "then": {"properties": {"failure_code": true}, "required": ["failure_code"]},
            "else": {"not": {"properties": {"failure_code": true}, "required": ["failure_code"]}}
          }
        ]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_revision_count", "factual_error_count", "rfq_total", "rfq_ready", "gate_bypass_count", "blocked_external_dependency_count"],
      "properties": {
        "manual_revision_count": {"type": "integer", "minimum": 0},
        "factual_error_count": {"type": "integer", "minimum": 0},
        "rfq_total": {"type": "integer", "minimum": 0},
        "rfq_ready": {"type": "integer", "minimum": 0},
        "gate_bypass_count": {"type": "integer", "minimum": 0},
        "blocked_external_dependency_count": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "go", "no_go"]},
        "decided_by_type": {"const": "human"},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision_ref": {"type": "string", "pattern": "^(synthetic|sanitized|evidence)-[a-z0-9-]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["go", "no_go"]}}, "required": ["status"]},
          "then": {
            "properties": {"decided_by_type": true, "decided_at": true, "decision_ref": true},
            "required": ["decided_by_type", "decided_at", "decision_ref"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"properties": {"decided_by_type": true}, "required": ["decided_by_type"]},
                {"properties": {"decided_at": true}, "required": ["decided_at"]},
                {"properties": {"decision_ref": true}, "required": ["decision_ref"]}
              ]
            }
          }
        }
      ]
    }
  }
}
