{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/product-ready.schema.json",
  "title": "ProductReady",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "source_ref", "evidence_refs", "field_evidence", "verification_status", "blocking_missing_fields", "optional_missing_fields", "product", "approval_ref"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "field_evidence": {
      "type": "object",
      "required": ["product.product_name", "product.product_type", "product.internal_sku"],
      "properties": {
        "product.product_name": {},
        "product.product_type": {},
        "product.internal_sku": {}
      },
      "propertyNames": {"pattern": "^(product|specifications|commercial)\\.[a-z_]+$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "verification_status": {"const": "verified"},
    "blocking_missing_fields": {"type": "array", "maxItems": 0},
    "optional_missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "product_type", "internal_sku"],
      "properties": {
        "product_name": {"type": "string", "minLength": 1},
        "product_type": {"enum": ["clutch_disc", "clutch_cover", "release_bearing", "clutch_kit"]},
        "internal_sku": {"type": "string", "minLength": 1},
        "oe_numbers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "application": {"type": "string", "minLength": 1},
        "vehicle_brand": {"type": "string", "minLength": 1},
        "vehicle_model": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {
          "properties": {"oe_numbers": {}},
          "required": ["oe_numbers"]
        },
        {
          "properties": {
            "application": {},
            "vehicle_brand": {},
            "vehicle_model": {}
          },
          "required": ["application", "vehicle_brand", "vehicle_model"]
        }
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clutch_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "spline_count": {"type": "integer", "minimum": 1},
        "spline_size": {"type": "string", "minLength": 1},
        "friction_material": {"type": "string", "minLength": 1},
        "kit_contents": {"type": "array", "items": {"enum": ["clutch_disc", "pressure_plate", "release_bearing"]}, "uniqueItems": true},
        "gross_weight_kg": {"type": "number", "exclusiveMinimum": 0},
        "net_weight_kg": {"type": "number", "exclusiveMinimum": 0},
        "package_size": {"type": "string", "minLength": 1}
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moq": {"type": "integer", "minimum": 1},
        "estimated_lead_time_days": {"type": "integer", "minimum": 0},
        "packaging": {"type": "string", "minLength": 1},
        "supported_customization": {"type": "string", "minLength": 1},
        "sample_available": {"type": "boolean"}
      }
    },
    "approval_ref": {"type": "string", "minLength": 1},
    "media_assets": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/productMediaAsset"}
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence-[a-zA-Z0-9][a-zA-Z0-9_-]{2,120}$"
    },
    "productMediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "productId", "evidenceRef", "mediaType", "origin", "technical", "semantic", "rights", "review", "createdAt"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "productId": {"type": "string", "format": "uuid"},
        "evidenceRef": {"$ref": "#/$defs/evidenceRef"},
        "mediaType": {"enum": ["image", "video"]},
        "origin": {"enum": ["factory", "user_upload", "licensed"]},
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentType", "width", "height", "durationMs", "fps", "hasAudio"],
          "properties": {
            "contentType": {"type": "string", "pattern": "^(image|video)/[a-zA-Z0-9.+-]+$"},
            "width": {"type": "integer", "minimum": 1, "maximum": 32768},
            "height": {"type": "integer", "minimum": 1, "maximum": 32768},
            "durationMs": {"type": ["integer", "null"], "minimum": 1, "maximum": 120000},
            "fps": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 240},
            "hasAudio": {"type": "boolean"}
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "description", "tags", "productVisible", "logoVisible", "textPresent"],
          "properties": {
            "role": {"enum": ["product_hero", "product_detail", "packaging", "factory", "inspection", "application", "other"]},
            "description": {"type": "string", "maxLength": 500},
            "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
            "productVisible": {"type": "boolean"},
            "logoVisible": {"type": "boolean"},
            "textPresent": {"type": "boolean"}
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rightsEvidenceRef", "editingAllowed", "publicDistributionAllowed", "paidAdvertisingAllowed", "imageToVideoAllowed", "referenceToVideoAllowed", "expiresAt"],
          "properties": {
            "rightsEvidenceRef": {"$ref": "#/$defs/evidenceRef"},
            "editingAllowed": {"type": "boolean"},
            "publicDistributionAllowed": {"type": "boolean"},
            "paidAdvertisingAllowed": {"type": "boolean"},
            "imageToVideoAllowed": {"type": "boolean"},
            "referenceToVideoAllowed": {"type": "boolean"},
            "expiresAt": {"type": ["string", "null"], "format": "date-time"}
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {"properties": {"imageToVideoAllowed": {"const": true}}, "required": ["imageToVideoAllowed"]},
                  {"properties": {"referenceToVideoAllowed": {"const": true}}, "required": ["referenceToVideoAllowed"]}
                ]
              },
              "then": {"properties": {"editingAllowed": {"const": true}}, "required": ["editingAllowed"]}
            }
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewedBy", "reviewedAt", "evidenceRef", "notes"],
          "properties": {
            "status": {"enum": ["pending", "approved", "rejected"]},
            "reviewedBy": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
            "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
            "evidenceRef": {"anyOf": [{"$ref": "#/$defs/evidenceRef"}, {"type": "null"}]},
            "notes": {"type": "string", "maxLength": 1000}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
              "then": {
                "properties": {
                  "reviewedBy": {"type": "null"},
                  "reviewedAt": {"type": "null"},
                  "evidenceRef": {"type": "null"}
                }
              },
              "else": {
                "properties": {
                  "reviewedBy": {"type": "string", "minLength": 1, "maxLength": 240},
                  "reviewedAt": {"type": "string", "format": "date-time"},
                  "evidenceRef": {"$ref": "#/$defs/evidenceRef"}
                }
              }
            }
          ]
        },
        "createdAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"mediaType": {"const": "image"}}, "required": ["mediaType"]},
          "then": {
            "properties": {
              "technical": {
                "properties": {
                  "contentType": {"type": "string", "pattern": "^image/"},
                  "durationMs": {"type": "null"},
                  "fps": {"type": "null"},
                  "hasAudio": {"const": false}
                }
              }
            }
          },
          "else": {
            "properties": {
              "technical": {
                "properties": {
                  "contentType": {"type": "string", "pattern": "^video/"},
                  "durationMs": {"type": "integer", "minimum": 1, "maximum": 120000},
                  "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240}
                }
              },
              "rights": {
                "properties": {"imageToVideoAllowed": {"const": false}}
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "type": "object",
            "properties": {"oe_numbers": {}},
            "required": ["oe_numbers"]
          }
        },
        "required": ["product"]
      },
      "then": {
        "properties": {
          "field_evidence": {
            "type": "object",
            "properties": {"product.oe_numbers": {}},
            "required": ["product.oe_numbers"]
          }
        }
      },
      "else": {
        "properties": {
          "field_evidence": {
            "type": "object",
            "properties": {
              "product.application": {},
              "product.vehicle_brand": {},
              "product.vehicle_model": {}
            },
            "required": ["product.application", "product.vehicle_brand", "product.vehicle_model"]
          }
        }
      }
    }
  ]
}
