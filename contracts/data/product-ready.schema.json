{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/product-ready.schema.json",
  "title": "ProductReady",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "source_ref", "evidence_refs", "field_evidence", "verification_status", "blocking_missing_fields", "optional_missing_fields", "product", "approval_ref"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "field_evidence": {
      "type": "object",
      "required": ["product.product_name", "product.product_type", "product.internal_sku"],
      "properties": {
        "product.product_name": {},
        "product.product_type": {},
        "product.internal_sku": {}
      },
      "propertyNames": {"pattern": "^(product|specifications|commercial)\\.[a-z_]+$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "verification_status": {"const": "verified"},
    "blocking_missing_fields": {"type": "array", "maxItems": 0},
    "optional_missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "product_type", "internal_sku"],
      "properties": {
        "product_name": {"type": "string", "minLength": 1},
        "product_type": {"enum": ["clutch_disc", "clutch_cover", "release_bearing", "clutch_kit"]},
        "internal_sku": {"type": "string", "minLength": 1},
        "oe_numbers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "application": {"type": "string", "minLength": 1},
        "vehicle_brand": {"type": "string", "minLength": 1},
        "vehicle_model": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {
          "properties": {"oe_numbers": {}},
          "required": ["oe_numbers"]
        },
        {
          "properties": {
            "application": {},
            "vehicle_brand": {},
            "vehicle_model": {}
          },
          "required": ["application", "vehicle_brand", "vehicle_model"]
        }
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clutch_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "spline_count": {"type": "integer", "minimum": 1},
        "spline_size": {"type": "string", "minLength": 1},
        "friction_material": {"type": "string", "minLength": 1},
        "kit_contents": {"type": "array", "items": {"enum": ["clutch_disc", "pressure_plate", "release_bearing"]}, "uniqueItems": true},
        "gross_weight_kg": {"type": "number", "exclusiveMinimum": 0},
        "net_weight_kg": {"type": "number", "exclusiveMinimum": 0},
        "package_size": {"type": "string", "minLength": 1}
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moq": {"type": "integer", "minimum": 1},
        "estimated_lead_time_days": {"type": "integer", "minimum": 0},
        "packaging": {"type": "string", "minLength": 1},
        "supported_customization": {"type": "string", "minLength": 1},
        "sample_available": {"type": "boolean"}
      }
    },
    "approval_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "type": "object",
            "properties": {"oe_numbers": {}},
            "required": ["oe_numbers"]
          }
        },
        "required": ["product"]
      },
      "then": {
        "properties": {
          "field_evidence": {
            "type": "object",
            "properties": {"product.oe_numbers": {}},
            "required": ["product.oe_numbers"]
          }
        }
      },
      "else": {
        "properties": {
          "field_evidence": {
            "type": "object",
            "properties": {
              "product.application": {},
              "product.vehicle_brand": {},
              "product.vehicle_model": {}
            },
            "required": ["product.application", "product.vehicle_brand", "product.vehicle_model"]
          }
        }
      }
    }
  ]
}
