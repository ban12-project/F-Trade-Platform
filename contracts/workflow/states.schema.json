{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/states.schema.json",
  "title": "AggregateWorkflowStates",
  "$defs": {
    "product": {
      "enum": [
        "PRODUCT_IMPORTED",
        "PRODUCT_REVIEW_REQUIRED",
        "PRODUCT_REVISION_REQUIRED",
        "PRODUCT_READY"
      ]
    },
    "content": {
      "enum": [
        "CONTENT_GENERATING",
        "CONTENT_REVIEW_REQUIRED",
        "CONTENT_REVISION_REQUIRED",
        "CONTENT_APPROVED",
        "CONTENT_PUBLISHED"
      ]
    },
    "video": {
      "enum": [
        "VIDEO_DRAFT",
        "VIDEO_RENDERING",
        "VIDEO_REVIEW_REQUIRED",
        "VIDEO_REVISION_REQUIRED",
        "VIDEO_APPROVED",
        "VIDEO_READY_FOR_GENERATION",
        "VIDEO_EXPORT_READY"
      ]
    },
    "rfq": { "enum": ["RFQ_COLLECTING", "RFQ_READY"] },
    "quotation": {
      "enum": [
        "QUOTE_DRAFT",
        "QUOTE_REVIEW_REQUIRED",
        "QUOTE_REVISION_REQUIRED",
        "QUOTE_APPROVED",
        "QUOTE_SENT"
      ]
    },
    "lead": { "enum": ["LEAD_RECEIVED", "FOLLOW_UP", "OPPORTUNITY", "WON", "LOST"] },
    "delivery_confirmation": {
      "enum": [
        "DELIVERY_CONFIRMATION_PENDING",
        "DELIVERY_CONFIRMATION_CONFIRMED",
        "DELIVERY_CONFIRMATION_REJECTED",
        "DELIVERY_CONFIRMATION_EXPIRED"
      ]
    },
    "state": {
      "enum": [
        "PRODUCT_IMPORTED",
        "PRODUCT_REVIEW_REQUIRED",
        "PRODUCT_REVISION_REQUIRED",
        "PRODUCT_READY",
        "CONTENT_GENERATING",
        "CONTENT_REVIEW_REQUIRED",
        "CONTENT_REVISION_REQUIRED",
        "CONTENT_APPROVED",
        "CONTENT_PUBLISHED",
        "VIDEO_DRAFT",
        "VIDEO_RENDERING",
        "VIDEO_REVIEW_REQUIRED",
        "VIDEO_REVISION_REQUIRED",
        "VIDEO_APPROVED",
        "VIDEO_READY_FOR_GENERATION",
        "VIDEO_EXPORT_READY",
        "RFQ_COLLECTING",
        "RFQ_READY",
        "QUOTE_DRAFT",
        "QUOTE_REVIEW_REQUIRED",
        "QUOTE_REVISION_REQUIRED",
        "QUOTE_APPROVED",
        "QUOTE_SENT",
        "LEAD_RECEIVED",
        "FOLLOW_UP",
        "OPPORTUNITY",
        "WON",
        "LOST",
        "DELIVERY_CONFIRMATION_PENDING",
        "DELIVERY_CONFIRMATION_CONFIRMED",
        "DELIVERY_CONFIRMATION_REJECTED",
        "DELIVERY_CONFIRMATION_EXPIRED"
      ]
    }
  }
}
