{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f-trade.example/contracts/quotation-handoff.schema.json",
  "title": "QuotationHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "rfq_id", "actor_type", "status", "quote", "approval"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "rfq_id": {"type": "string", "minLength": 1},
    "actor_type": {"const": "human"},
    "status": {"enum": ["review_required", "approved", "sent"]},
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_price", "currency", "moq", "lead_time_days", "payment_terms", "validity_days"],
      "properties": {
        "unit_price": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "moq": {"type": "integer", "minimum": 1},
        "lead_time_days": {"type": "integer", "minimum": 0},
        "payment_terms": {"type": "string", "minLength": 1},
        "validity_days": {"type": "integer", "minimum": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "evidence_ref"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
